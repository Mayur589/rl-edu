# RL Tutor Environment Variables

# Application
PROJECT_NAME="RL Tutor"
ENVIRONMENT=development
DEBUG=true

# Database (Leave as SQLite for zero-setup local dev, or provide PostgreSQL URI)
DATABASE_URL=sqlite:///./rl_edu.db
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/rltutor

# Security & JWT
SECRET_KEY=super-secret-rl-tutor-key-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Reinforcement Learning Defaults
RL_LEARNING_RATE=0.005
RL_GAMMA=0.95
RL_EPSILON_START=1.0
RL_EPSILON_MIN=0.05
RL_EPSILON_DECAY=0.995

# Cognitive BKT Defaults
BKT_P_INIT=0.20
BKT_P_TRANSIT=0.15
BKT_P_SLIP=0.10
BKT_P_GUESS=0.25
BKT_HINT_BOOST=0.10
BKT_FORGETTING_RATE=0.02
